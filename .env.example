# ── Bridge ───────────────────────────────────────────────────────────────────
BRIDGE_PORT=8787
INTERNAL_PORT=8788
BRIDGE_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/bridge.db
WORKSPACE_ROOT=C:/Users/Zouyu/repos/dsh-mobile-ui
RETENTION_UPDATES=5000
LEASE_GRACE_MS=10000
PERMISSION_TTL_MS=180000
LOG_LEVEL=info

# ── DSH ACP child ────────────────────────────────────────────────────────────
# Normal installation:
#   DSH_BIN=dsh
#   DSH_ARGS=["--profile","acp"]
#
# Local source checkout (already built, run with tsx):
# DSH needs Node ^22.19.0 || >=24 for `import.meta.main`. Use that node binary
# explicitly if your default Node is older.
DSH_BIN=C:/Users/Zouyu/AppData/Roaming/fnm/node-versions/v22.19.0/installation/node.exe
DSH_ARGS=["--import","tsx/esm","apps/cli/src/bin.ts","--profile","acp"]
DSH_CWD=C:/Users/Zouyu/CodeReviews/deepseek-harness
DSH_HOME=C:/Users/Zouyu/.dsh
ACP_ENABLED=true

# ── Speech-to-text (STT) ─────────────────────────────────────────────────────
# Opt-in. Start the FunASR service from deploy/stt/ first, then set this to true.
STT_ENABLED=false
STT_PROVIDER=funasr
# Same-host FunASR Docker:
STT_BASE_URL=http://127.0.0.1:8000/v1
# LAN GPU machine (comment the line above and uncomment this):
# STT_BASE_URL=http://192.168.71.5:8000/v1
# paraformer = Chinese + punctuation; sensevoice is a faster alternative.
STT_MODEL=paraformer
STT_LANGUAGE=zh
STT_TIMEOUT_MS=60000
STT_MAX_BYTES=8388608
STT_MAX_DURATION_MS=60000
STT_CONCURRENCY=1
# Name of the env var holding an optional key; never put the raw key here.
# STT_API_KEY_ENV=STT_API_KEY
