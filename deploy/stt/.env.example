# Copy to .env for local overrides: cp .env.example .env
#
# Host publication address. Default is loopback only because the FunASR example
# server has no authentication. Use 0.0.0.0:8000 only on a trusted LAN.
FUNASR_HOST_PORT=127.0.0.1:8000

# --- Build inputs (docker compose build) -------------------------------------
# Base image. Default is the locally cached python:3.12-slim, so the build does
# not pull from Docker Hub (which failed token auth/IPv6 here). On a machine
# without that image, either pull it or point to a working mirror, e.g.
# https://docker.m.daocloud.io/library/python:3.12-slim or
# https://docker.1ms.run/library/python:3.12-slim (mirrors were not verified
# from this host; test before relying on them).
PYTHON_IMAGE=python:3.12-slim

# PyPI index for FunASR and server dependencies.
# Fallback: https://pypi.org/simple
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# torch/torchaudio CPU wheel index. Domestic alternative (verified to host
# 2.6.0 cp312): https://mirror.sjtu.edu.cn/pytorch-wheels/cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.6.0

# FunASR source. Domestic alternative (reachable, pinned commit present):
# https://gitee.com/mirrors/FunASR.git
FUNASR_REPO=https://github.com/modelscope/FunASR.git
FUNASR_COMMIT=d91d961e37a005837b1523bcc6b09f087877be54
