# Copy to deploy/.env (git-ignored): cp .env.example .env
# Compose loads this file for interpolation and passes it to the bridge service.

# ── Secrets (required) ───────────────────────────────────────────────────────
# At least 8 characters; used as the Bearer token for phones.
BRIDGE_SECRET=change-me-to-a-long-random-string
# Gateway key. Only its name is referenced by the DSH profile; never put it in
# the profile YAML or any committed file.
GATEAWAY_API_KEY=replace-with-gateway-key

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
STT_MODEL=paraformer
WEB_PORT=8443

# Optional: bind a host workspace into the container instead of the empty
# dsh-workspace named volume. Example (WSL/Linux path):
# WORKSPACE_PATH=/home/you/work
# Leave unset to use the named volume. on Windows use a path Docker Desktop can share.

# ── Images and mirrors ───────────────────────────────────────────────────────
# Locally cached images avoid Docker Hub token/IPv6 failures. Domestic mirror
# examples: docker.m.daocloud.io/library/node:22-bookworm-slim,
# docker.m.daocloud.io/library/caddy:2-alpine.
NODE_IMAGE=node:22-bookworm-slim
CADDY_IMAGE=caddy:2-alpine
NPM_REGISTRY=https://registry.npmmirror.com
PNPM_VERSION=10.25.0
DSH_VERSION=0.2.1-rc.2

# Debian apt mirrors rewritten inside the bridge image.
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security

# STT build inputs (reuse deploy/stt defaults; override for other networks).
STT_PYTHON_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.6.0
FUNASR_REPO=https://github.com/modelscope/FunASR.git
FUNASR_COMMIT=d91d961e37a005837b1523bcc6b09f087877be54
